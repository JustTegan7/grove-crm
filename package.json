{
  "name": "grove",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @grove/web",
    "build": "npm run build -w @grove/web",
    "lint": "npm run lint -w @grove/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run generate -w @grove/db",
    "db:migrate": "npm run migrate -w @grove/db"
  },
  "engines": { "node": ">=20" }
}
