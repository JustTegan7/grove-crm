{
  "expo": {
    "name": "Grove",
    "slug": "grove",
    "scheme": "grove",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.thegrovecms.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.thegrovecms.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F3D3A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Grove uses the camera to scan the QR code that logs you in on your computer and to photograph a storefront or business card for a lead."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Grove uses the camera to scan the QR code that logs you in on your computer and to photograph a storefront or business card for a lead.",
          "photosPermission": "Grove lets you attach photos from your library to a lead."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4FB39C"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0F3D3A",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
