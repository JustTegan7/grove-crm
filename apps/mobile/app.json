{
  "expo": {
    "name": "Grove",
    "slug": "grove",
    "scheme": "grove",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.thegrovecms.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.thegrovecms.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Grove uses the camera only to scan the QR code that logs you in on your computer."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}